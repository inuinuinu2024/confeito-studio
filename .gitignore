# dependencies
**/node_modules/
**/.venv/

# build / caches
**/dist/
**/__pycache__/
**/*.egg-info/
**/.ruff_cache/
**/.pytest_cache/

# E2E output (screenshots, observations.json, server logs)
frontend/e2e/.output/

# setup/start-app.ps1 debug logs ($LOG_ENABLED = $true)
setup/*.log

# Environment / secrets (GEMINI_API_KEY)
.env

# User data — never commit or delete
archives/
# Registered prompts shared by every tool (assets/prompts/prompts.json), its temp file and broken copies set aside
assets/prompts/
# The user's tool settings (initial values are settings/default_settings.json) and broken copies set aside;
# settings/prompts.* is where registered prompts used to be (no longer read, kept if present)
settings/user_settings.json
settings/user_settings.json.tmp
settings/user_settings.broken-*.json
settings/prompts.json
settings/prompts.json.tmp
settings/prompts.broken-*.json

# Local models (rembg isnet-anime.onnx)
models/

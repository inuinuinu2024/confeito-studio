{
  "name": "confeito-studio",
  "version": "0.1.0",
  "description": "ConfeitO Studio frontend (Vite + TypeScript, no framework)",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "node e2e/smoke.mts",
    "check": "npm run typecheck && npm run format:check && npm run test && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "material-symbols": "^0.45.10"
  }
}
